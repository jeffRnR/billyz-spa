generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  SUPER_ADMIN
  RECEPTIONIST
  ATTENDANT
  INVENTORY_MANAGER
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  VOID
}

enum SaleStatus {
  UNPAID
  PAID
  VOID
}

enum PaymentChannel {
  TILL
  PAYBILL
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESSFUL
  FAILED
}

enum StockMovementType {
  OPENING
  ADDITION
  DEDUCTION
  ADJUSTMENT
  SALE
}

enum ReconciliationStatus {
  MATCHED
  UNMATCHED
  DISCREPANCY
}

enum TargetType {
  SERVICE_COUNT
  SALES_VALUE
}

// ---------- Org & users ----------
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users        User[]
  customers    Customer[]
  visits       CustomerVisit[]
  transactions ServiceTransaction[]
  inventories  Inventory[]
  stockMoves   StockMovement[]
  productSales ProductSale[]
  payments     Payment[]
  targets      StaffTarget[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  branchId     String? // null only for SUPER_ADMIN
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])

  visitsRecorded   CustomerVisit[]
  transactionsMade ServiceTransaction[]     @relation("TransactionCreator")
  transactionItems ServiceTransactionItem[]
  commissionRules  CommissionRule[]
  commissions      CommissionRecord[]
  stockMoves       StockMovement[]
  productSales     ProductSale[]
  targets          StaffTarget[]
  reconciliations  ReconciliationRecord[]

  @@index([branchId, role])
}

// ---------- Customers ----------
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  branchId  String
  createdAt DateTime @default(now())

  branch       Branch               @relation(fields: [branchId], references: [id])
  visits       CustomerVisit[]
  transactions ServiceTransaction[]
  productSales ProductSale[]

  @@unique([branchId, phone])
}

model CustomerVisit {
  id           String   @id @default(cuid())
  customerId   String
  branchId     String
  recordedById String
  visitedAt    DateTime @default(now())

  customer     Customer             @relation(fields: [customerId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id])
  recordedBy   User                 @relation(fields: [recordedById], references: [id])
  transactions ServiceTransaction[]

  @@index([branchId, visitedAt])
}

// ---------- Services ----------
model ServiceCategory {
  id       String    @id @default(cuid())
  name     String    @unique // Kinyozi, Salon, SPA
  services Service[]
}

model Service {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  price      Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  category        ServiceCategory          @relation(fields: [categoryId], references: [id])
  items           ServiceTransactionItem[]
  commissionRules CommissionRule[]
  targets         StaffTarget[]

  @@unique([categoryId, name])
}

model ServiceTransaction {
  id          String     @id @default(cuid())
  branchId    String
  customerId  String
  visitId     String?
  createdById String
  status      SaleStatus @default(UNPAID)
  totalAmount Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  branch    Branch         @relation(fields: [branchId], references: [id])
  customer  Customer       @relation(fields: [customerId], references: [id])
  visit     CustomerVisit? @relation(fields: [visitId], references: [id])
  createdBy User           @relation("TransactionCreator", fields: [createdById], references: [id])

  items           ServiceTransactionItem[]
  payments        Payment[]
  reconciliations ReconciliationRecord[]

  @@index([branchId, createdAt])
  @@index([customerId])
}

// One line per service performed; attendantId is the attendant assignment.
model ServiceTransactionItem {
  id            String  @id @default(cuid())
  transactionId String
  serviceId     String
  attendantId   String
  unitPrice     Decimal @db.Decimal(12, 2) // price snapshot
  quantity      Int     @default(1)
  lineTotal     Decimal @db.Decimal(12, 2)

  transaction ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  service     Service            @relation(fields: [serviceId], references: [id])
  attendant   User               @relation(fields: [attendantId], references: [id])
  commission  CommissionRecord?

  @@index([attendantId])
  @@index([serviceId])
}

// ---------- Commissions ----------
model CommissionRule {
  id          String         @id @default(cuid())
  serviceId   String
  attendantId String? // optional per-attendant override
  type        CommissionType
  value       Decimal        @db.Decimal(12, 2) // KES amount or percent
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  service   Service            @relation(fields: [serviceId], references: [id])
  attendant User?              @relation(fields: [attendantId], references: [id])
  records   CommissionRecord[]
}

model CommissionRecord {
  id          String           @id @default(cuid())
  itemId      String           @unique
  attendantId String
  ruleId      String?
  type        CommissionType // snapshot
  rate        Decimal          @db.Decimal(12, 2) // snapshot
  baseAmount  Decimal          @db.Decimal(12, 2)
  amount      Decimal          @db.Decimal(12, 2)
  status      CommissionStatus @default(PENDING)
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())

  item      ServiceTransactionItem @relation(fields: [itemId], references: [id])
  attendant User                   @relation(fields: [attendantId], references: [id])
  rule      CommissionRule?        @relation(fields: [ruleId], references: [id])

  @@index([attendantId, status])
}

// ---------- Products & inventory ----------
model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  inventories Inventory[]
  stockMoves  StockMovement[]
  saleItems   ProductSaleItem[]
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String
  branchId          String
  quantity          Int      @default(0)
  lowStockThreshold Int? // null = no alert until rule confirmed
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  branchId      String
  type          StockMovementType
  quantity      Int // signed: + in, - out
  balanceAfter  Int
  reason        String?
  userId        String
  productSaleId String?
  createdAt     DateTime          @default(now())

  product     Product      @relation(fields: [productId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  productSale ProductSale? @relation(fields: [productSaleId], references: [id])

  @@index([branchId, productId, createdAt])
}

model ProductSale {
  id          String     @id @default(cuid())
  branchId    String
  customerId  String? // optional until rule confirmed
  soldById    String
  status      SaleStatus @default(UNPAID)
  totalAmount Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  branch   Branch    @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  soldBy   User      @relation(fields: [soldById], references: [id])

  items           ProductSaleItem[]
  stockMoves      StockMovement[]
  payments        Payment[]
  reconciliations ReconciliationRecord[]

  @@index([branchId, createdAt])
}

model ProductSaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) // snapshot
  lineTotal Decimal @db.Decimal(12, 2)

  sale    ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
}

// ---------- Targets ----------
model StaffTarget {
  id          String     @id @default(cuid())
  userId      String
  branchId    String
  type        TargetType
  serviceId   String? // for service-specific targets
  targetValue Decimal    @db.Decimal(12, 2)
  periodStart DateTime
  periodEnd   DateTime

  user    User     @relation(fields: [userId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([userId, periodStart])
}

// ---------- Payments (M-Pesa) ----------
model Payment {
  id                   String         @id @default(cuid())
  branchId             String
  amount               Decimal        @db.Decimal(12, 2)
  channel              PaymentChannel
  status               PaymentStatus  @default(INITIATED)
  mpesaReceipt         String?        @unique // idempotency key
  paidAt               DateTime?
  serviceTransactionId String?
  productSaleId        String?
  createdAt            DateTime       @default(now())

  branch             Branch                 @relation(fields: [branchId], references: [id])
  serviceTransaction ServiceTransaction?    @relation(fields: [serviceTransactionId], references: [id])
  productSale        ProductSale?           @relation(fields: [productSaleId], references: [id])
  providerRecord     PaymentProviderRecord?
  reconciliation     ReconciliationRecord?

  @@index([status, createdAt])
  @@index([serviceTransactionId])
  @@index([productSaleId])
}

// Provider-specific data kept out of the core Payment model.
model PaymentProviderRecord {
  id                String   @id @default(cuid())
  paymentId         String   @unique
  checkoutRequestId String?  @unique
  merchantRequestId String?
  payerPhone        String?
  resultCode        Int?
  resultDesc        String?
  rawPayload        Json?
  createdAt         DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model ReconciliationRecord {
  id                   String               @id @default(cuid())
  paymentId            String               @unique
  serviceTransactionId String?
  productSaleId        String?
  expectedAmount       Decimal?             @db.Decimal(12, 2)
  paidAmount           Decimal              @db.Decimal(12, 2)
  status               ReconciliationStatus
  notes                String?
  reconciledById       String?
  reconciledAt         DateTime             @default(now())

  payment            Payment             @relation(fields: [paymentId], references: [id])
  serviceTransaction ServiceTransaction? @relation(fields: [serviceTransactionId], references: [id])
  productSale        ProductSale?        @relation(fields: [productSaleId], references: [id])
  reconciledBy       User?               @relation(fields: [reconciledById], references: [id])

  @@index([status])
}
